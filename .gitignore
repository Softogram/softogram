# Softogram .gitignore

# IDE / editors
.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing / coverage
coverage/
/coverage

# Next.js leftovers (if any)
.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/

# Environment files (never commit secrets)
*.env
*.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Token / credential dumps
*token.json*
*credentials.json*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System / secrets accidentally dropped in tree
.DS_Store
*.pem
.gitconfig

# Python
__pycache__/
*.pyc
venv/
.venv/
.venv-p1/

# Caches / local analysis
.cache/
graphify-out/

# Prototype redesign tree (gitignored workspace copy)
Redesign-Softogram-Website/

# Contact leads + CMS runtime writes (PII / mutable content)
backend/data/

# Archives / mobile junk
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
android-sdk/

# Misc tooling
agenthub/agents/youtube/db
chainlit.md
.chainlit
.ipynb_checkpoints/
.vercel
.ac
