# Softogram API environment template (copy to backend/.env — never commit secrets)

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://softogram.in,https://www.softogram.in

SENDGRID_API_KEY=
SENDER_EMAIL=admin@softogram.in
RECIPIENT_EMAIL=support@softogram.in

# Optional: override SendGrid host for the local e2e mock
# SENDGRID_HOST=http://localhost:8025

MONGO_URL=mongodb://localhost:27017
DB_NAME=softogram

CONTACT_RATE_LIMIT_PER_MINUTE=2
CONTACT_RATE_LIMIT_PER_HOUR=5
# E2E only — never enable in production
# ALLOW_E2E_CLIENT_ID=1

# Admin CMS password (issue #17). Required for /api/admin/* mutations.
ADMIN_PASSWORD=change-me-before-deploy

# Optional override for mutable CMS JSON directory (default: backend/data)
# LEADS_DATA_DIR=/var/lib/softogram/leads
