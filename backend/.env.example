# Softogram API environment template (copy to backend/.env — never commit secrets)

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://softogram.in,https://www.softogram.in

# Email is sent via AWS SES (sesv2). The domain must be verified in SES with
# DKIM records added to DNS; see docs/ops/email-domain-auth.md.
SENDER_EMAIL=admin@softogram.in
RECIPIENT_EMAIL=support@softogram.in
# AWS_SES_REGION=ap-south-2

# Optional: point the SES client at the local e2e mock instead of real AWS
# AWS_SES_ENDPOINT_URL=http://localhost:8025

# Primary database (issue #31/#32). Run `docker compose up -d` for a local instance.
DATABASE_URL=postgresql+asyncpg://softogram:softogram@localhost:5432/softogram

CONTACT_RATE_LIMIT_PER_MINUTE=2
CONTACT_RATE_LIMIT_PER_HOUR=5

# Admin login attempts (issue #35-37 hardening). Default 5/min, 20/hour.
# ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
# ADMIN_LOGIN_RATE_LIMIT_PER_HOUR=20
# E2E only — never enable in production
# ALLOW_E2E_CLIENT_ID=1

# Optional: seed/update an admin on boot (CI/e2e only — prefer scripts/seed_admin.py in prod).
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=

# Optional override for where email-send failure logs are written (default: backend/data)
# LEADS_DATA_DIR=/var/lib/softogram/data
