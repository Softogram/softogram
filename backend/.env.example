# Softogram API environment template (copy to backend/.env — never commit secrets)

# Comma-separated browser origins allowed to call the API.
# Production (required):
# CORS_ORIGINS=https://softogram.in,https://www.softogram.in
# Local CRA against a local API:
# CORS_ORIGINS=http://localhost:3000
# E2E sets this automatically via playwright.config.js.
CORS_ORIGINS=https://softogram.in,https://www.softogram.in

SENDGRID_API_KEY=
SENDER_EMAIL=admin@softogram.in
RECIPIENT_EMAIL=support@softogram.in

# Optional: override SendGrid host for the local e2e mock (default api.sendgrid.com)
# SENDGRID_HOST=http://localhost:8025

# Mongo (optional mirror for contact leads — JSONL is the durable fallback)
MONGO_URL=mongodb://localhost:27017
DB_NAME=softogram

# Optional override for lead JSONL directory (default: backend/data)
# LEADS_DATA_DIR=/var/lib/softogram/leads
